-- A null level keeps the stored one
upsertLevels:
INSERT INTO players (id, incubator_level, solarium_level, laying_technique_level, aphid_farm_level)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT (id) DO UPDATE SET
    incubator_level = coalesce(excluded.incubator_level, incubator_level),
    solarium_level = coalesce(excluded.solarium_level, solarium_level),
    laying_technique_level = coalesce(excluded.laying_technique_level, laying_technique_level),
    aphid_farm_level = coalesce(excluded.aphid_farm_level, aphid_farm_level);

-- A member found by a sync gets the given settlement, unless a choice was saved before. Levels are kept
insertMember:
INSERT INTO players (id, wage_settlement) VALUES (?, ?)
ON CONFLICT (id) DO UPDATE SET wage_settlement = coalesce(wage_settlement, excluded.wage_settlement);

selectByIds:
SELECT * FROM players WHERE id IN ?;

upsertWageSettlement:
INSERT INTO players (id, wage_settlement) VALUES (?, ?)
ON CONFLICT (id) DO UPDATE SET wage_settlement = excluded.wage_settlement;

upsertDebt:
INSERT INTO players (id, debt) VALUES (?, ?)
ON CONFLICT (id) DO UPDATE SET debt = excluded.debt;

upsertChief:
INSERT INTO players (id, is_chief) VALUES (?, ?)
ON CONFLICT (id) DO UPDATE SET is_chief = excluded.is_chief;

-- The latest visit, from any device
upsertLastSeen:
INSERT INTO players (id, last_seen_at) VALUES (?, ?)
ON CONFLICT (id) DO UPDATE SET last_seen_at = excluded.last_seen_at;
