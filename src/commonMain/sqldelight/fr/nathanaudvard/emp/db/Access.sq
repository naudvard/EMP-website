insertLink:
INSERT INTO access_links (player_id, token_hash, created_at, created_by, sent_at)
VALUES (?, ?, ?, ?, ?)
RETURNING id;

-- A player has one link at a time: the others were replaced
activeLink:
SELECT id FROM access_links WHERE player_id = ? AND revoked_at IS NULL;

linkByTokenHash:
SELECT id, player_id FROM access_links WHERE token_hash = ? AND revoked_at IS NULL;

renewLinkToken:
UPDATE access_links SET token_hash = ?, sent_at = ? WHERE id = ?;

revokeLinks:
UPDATE access_links SET revoked_at = :revokedAt WHERE player_id = :playerId AND revoked_at IS NULL;

expireSessions:
UPDATE sessions SET expires_at = :expiresAt
WHERE player_id = :playerId AND julianday(expires_at) > julianday(:expiresAt);

sentLinks:
SELECT player_id, sent_at FROM access_links WHERE player_id IN ? AND revoked_at IS NULL;

insertSession:
INSERT INTO sessions (id_hash, player_id, access_link_id, created_at, last_seen_at, expires_at)
VALUES (?, ?, ?, ?, ?, ?);

-- A session of a replaced link is closed, whatever its expiry
session:
SELECT sessions.id, sessions.player_id, sessions.access_link_id, sessions.expires_at
FROM sessions JOIN access_links ON access_links.id = sessions.access_link_id
WHERE sessions.id_hash = ? AND access_links.revoked_at IS NULL;

renewSession:
UPDATE sessions SET last_seen_at = :lastSeenAt, expires_at = :expiresAt WHERE id = :id;

insertDeviceCode:
INSERT INTO device_codes (code, player_id, access_link_id, created_at, expires_at) VALUES (?, ?, ?, ?, ?);

-- The latest one: an older code may have had the same value. The code of a replaced link counts as used
deviceCode:
SELECT device_codes.id, device_codes.player_id, device_codes.access_link_id, device_codes.expires_at,
    coalesce(device_codes.used_at, access_links.revoked_at) AS used_at
FROM device_codes JOIN access_links ON access_links.id = device_codes.access_link_id
WHERE device_codes.code = ? ORDER BY device_codes.id DESC LIMIT 1;

useDeviceCode:
UPDATE device_codes SET used_at = ? WHERE id = ? AND used_at IS NULL;
