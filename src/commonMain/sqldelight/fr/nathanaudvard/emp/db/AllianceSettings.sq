selectSettings:
SELECT * FROM alliance_settings WHERE alliance_tag = ?;

upsertSettings:
INSERT INTO alliance_settings (alliance_tag, computation_time, distribution, updated_at, updated_by)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT (alliance_tag) DO UPDATE SET
    computation_time = excluded.computation_time,
    distribution = excluded.distribution,
    updated_at = excluded.updated_at,
    updated_by = excluded.updated_by;
