deleteVersion:
DELETE FROM exported_alliances WHERE version = ? AND tag IN ?;

insert:
INSERT INTO exported_alliances (
    version, tag, name, players_count, total_field,
    total_building_score, total_technology_score, total_trophy_score, wars
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
RETURNING id;

insertPact:
INSERT INTO exported_alliance_pacts (alliance_id, tag, name, description)
VALUES (?, ?, ?, ?);

latest:
SELECT * FROM exported_alliances WHERE tag = ? ORDER BY version DESC LIMIT 1;

pacts:
SELECT tag, name, description FROM exported_alliance_pacts WHERE alliance_id = ? ORDER BY tag;
