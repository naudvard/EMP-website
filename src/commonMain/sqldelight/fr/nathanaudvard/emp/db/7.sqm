-- Resources are whole units, rounded down. SQLite has no ALTER COLUMN: the table is rebuilt.
-- CAST truncates towards zero; subtracting (x < CAST(x)) turns it into a floor for negative values.
CREATE TABLE wages_floored AS
SELECT
    computation_id,
    player_id,
    pseudo,
    average_field,
    CAST(self_production AS INTEGER) - (self_production < CAST(self_production AS INTEGER)) AS self_production,
    laying_time,
    CAST(theoretical_need AS INTEGER) - (theoretical_need < CAST(theoretical_need AS INTEGER)) AS theoretical_need,
    build_time_seconds,
    reduction_factor,
    CAST(relative_need AS INTEGER) - (relative_need < CAST(relative_need AS INTEGER)) AS relative_need,
    CAST(gross_wage AS INTEGER) - (gross_wage < CAST(gross_wage AS INTEGER)) AS gross_wage
FROM wages;

DROP TABLE wages;

CREATE TABLE wages (
    computation_id INTEGER NOT NULL REFERENCES wage_computations(id) ON DELETE CASCADE,
    player_id INTEGER NOT NULL,
    pseudo TEXT NOT NULL,
    average_field REAL NOT NULL,
    self_production INTEGER NOT NULL,
    laying_time INTEGER NOT NULL,
    theoretical_need INTEGER NOT NULL,
    build_time_seconds REAL NOT NULL,
    reduction_factor REAL NOT NULL,
    relative_need INTEGER NOT NULL,
    gross_wage INTEGER NOT NULL,
    wage_to_distribute INTEGER NOT NULL,
    PRIMARY KEY (computation_id, player_id)
);

INSERT INTO wages
SELECT
    computation_id, player_id, pseudo, average_field, self_production, laying_time, theoretical_need,
    build_time_seconds, reduction_factor, relative_need, gross_wage, gross_wage - self_production
FROM wages_floored;

DROP TABLE wages_floored;
